# ─────────────────────────────────────────────────────────────────
#  .env.example  —  Required Environment Variables
#
#  Railway / Local setup ke liye:
#  1. Is file ko copy karo:  cp .env.example .env.development
#  2. Apni real values bharo
#  3. Kabhi bhi .env.development ya .env.production commit mat karo
# ─────────────────────────────────────────────────────────────────

# ── API URLs (Vite frontend ke liye) ─────────────────────────────
VITE_API_URL=
VITE_MAIN_API_URL=
VITE_AUTH_API_URL=
VITE_CHAT_API_URL=
VITE_CNIC_API_URL=
VITE_DISPUTE_API_URL=

# ── Database ──────────────────────────────────────────────────────
MONGO_URI=

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend URL (Stripe redirect) ───────────────────────────────
FRONTEND_URL=

# ── Maps ──────────────────────────────────────────────────────────
MAPS_API_KEY=

# ── Flask / BERT ──────────────────────────────────────────────────
FLASK_API_URL=

# ── CORS (comma-separated URLs) ───────────────────────────────────
CORS_ORIGINS=

# ── Environment ───────────────────────────────────────────────────
NODE_ENV=development
